															"name": "ActionBar",
															"documentation": "Attributes that can be used with a ActionBar.\n           <p>Includes the following attributes:</p>\n           <table>\n           <colgroup align=\"left\" />\n           <colgroup align=\"left\" />\n           <tr><th>Attribute</th><th>Description</th></tr>\n           <tr><td><code>{@link #ActionBar_background com.amazon.parserprototype:background}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_backgroundSplit com.amazon.parserprototype:backgroundSplit}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_backgroundStacked com.amazon.parserprototype:backgroundStacked}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_contentInsetEnd com.amazon.parserprototype:contentInsetEnd}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_contentInsetLeft com.amazon.parserprototype:contentInsetLeft}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_contentInsetRight com.amazon.parserprototype:contentInsetRight}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_contentInsetStart com.amazon.parserprototype:contentInsetStart}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_customNavigationLayout com.amazon.parserprototype:customNavigationLayout}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_displayOptions com.amazon.parserprototype:displayOptions}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_divider com.amazon.parserprototype:divider}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_elevation com.amazon.parserprototype:elevation}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_height com.amazon.parserprototype:height}</code></td><td></td></tr>\n           <tr><td><code>{@link #ActionBar_hideOnContentScroll com.amazon.parserprototype:hideOnContentScroll}</code></td><td></td></tr>\n           <tr><td><code>{@link #Actio