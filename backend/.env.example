# Copy to .env and fill in. Never commit the real .env.
#
# The application runs with every value below left blank. GitHub and the model
# provider are both optional; without them you get the manual workflow and the
# deterministic analysis path, which is a complete, usable system.

# --- required in any deployment ----------------------------------------------
# Signs session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, an ephemeral key is generated and sessions do not survive a restart.
SECRET_KEY=

# --- GitHub (optional) --------------------------------------------------------
# From GitHub > Settings > Developer settings > OAuth Apps. The app's callback
# URL must match the frontend origin. Leave blank to disable repository import;
# uploads and the in-browser editor work regardless.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shared secret configured on the repository webhook. When set, unsigned
# deliveries are rejected.
GITHUB_WEBHOOK_SECRET=

# --- model provider (optional) -------------------------------------------------
# openai     -> the OpenAI API (OPENAI_API_KEY)
# ollama     -> a model running locally under Ollama. No API key. See below.
# compatible -> any other OpenAI-compatible endpoint (set LLM_BASE_URL): Azure,
#               OpenRouter, vLLM, LM Studio
# anthropic  -> the Anthropic API (ANTHROPIC_API_KEY); needs `pip install anthropic`
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o

# --- local models via Ollama ----------------------------------------------------
# Set LLM_PROVIDER=ollama and LLM_MODEL to a tag from `ollama list`, exactly as
# it appears there -- e.g. qwen2.5-coder:7b, not qwen2.5-coder. No key needed.
OLLAMA_BASE_URL=http://localhost:11434/v1
#
# The context window requested for each call, and the setting most likely to
# cost you a correct answer if it is wrong. Ollama defaults many models to 2048
# tokens and TRUNCATES A LONGER PROMPT SILENTLY -- the response still looks
# normal, but the model saw a fragment of your project. This value is sent with
# every request, and the app warns on the Results screen if a prompt would
# still not fit. Raise it for large projects; lower it if you are short on VRAM.
OLLAMA_NUM_CTX=16384
#
# How long to wait when checking whether the daemon is up. The check runs in the
# background and never blocks a page load, so this rarely needs changing.
OLLAMA_PROBE_TIMEOUT=1.0

# auto (default) uses the API when a key is present and the deterministic path
# otherwise; offline never calls out, which is what the experiments use.
LLM_MODE=auto
LLM_TEMPERATURE=0
LLM_SEED=20260815
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# Extra models for the cross-model agreement study, "provider:model" each.
# e.g. anthropic:claude-sonnet-4-5,openai:gpt-4o-mini,ollama:qwen2.5-coder:7b
LLM_COMPARISON_MODELS=

# Used only to report estimated cost in /metrics.
USD_PER_1M_INPUT_TOKENS=5.00
USD_PER_1M_OUTPUT_TOKENS=15.00

# --- incremental analysis -------------------------------------------------------
# always | content | structural | isomorphism
GATE_STRATEGY=structural
MAX_GRAPH_VERSIONS=3
IMPACT_RADIUS=1

# Whether UML associations count toward the similarity score. Off by default:
# an association cannot be proven from an AST, only evidenced. Findings are
# reported either way, and the choice is recorded in every result.
ASSOCIATION_SCORING=false

# --- limits ----------------------------------------------------------------------
MAX_ANALYSES_PER_HOUR=60
MAX_UPLOAD_BYTES=209715200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where projects are stored. Defaults to ../workspace relative to the backend.
# WORKSPACE_DIR=
# DATABASE_URL=sqlite:///./conformance_app.db
